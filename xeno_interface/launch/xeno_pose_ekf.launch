<!-- Deprecated. Use xeno_robot_localization.launch instead -->
<launch> 
  <node pkg="robot_pose_ekf" type="robot_pose_ekf" name="xeno_pose_ekf"
		output="screen">
	<param name="output_frame" value="odom"/>
	<param name="base_footprint_frame" value="base_footprint"/>
	<param name="output_frame" value="odom_combined"/>

    <param name="freq" value="30.0"/>
    <param name="sensor_timeout" value="1"/>
    <param name="odom_used" value="true"/>
    <param name="imu_used" value="true"/>
    <param name="vo_used" value="false"/>
    <param name="debug" value="true"/>
    <param name="self_diagnose" value="true"/>

	<remap from="odom" to="/odom_prep" />
	<remap from="vo" to="/viso2_stereo_odometer/odometry" />
	<remap from="imu_data" to="/imu_prep" />	
  </node>
</launch>
