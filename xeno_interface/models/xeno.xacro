<?xml version="1.0"?>
<!--
@author Jose Alvarez-Ruiz 
@date March 2016
@brief Robot model definition the xeno wheelchair. Based on:
https://github.com/CURG/wheelchair_description/blob/master/models/wheelchair.xacro
-->

<robot name="xeno_wheelchair" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- useful definition -->
    <xacro:property name="halfpi" value="1.57079633" />
    <xacro:property name="sixthpi" value="0.523598776" />

  
    <!-- wheelchair properties -->
	<xacro:property name="rear_wheel_diameter" value="0.34" />
    <xacro:property name="rear_wheel_thickness" value="0.075" />
	<xacro:property name="rear_wheel_axis_offset" value="0.26" />
    <xacro:property name="front_wheel_diameter" value="0.2" />
    <xacro:property name="front_wheel_thickness" value="0.06" />	
	<xacro:property name="front_wheel_hold_length" value="0.10" />
	<xacro:property name="front_wheel_hold_width" value="0.20" />
	<xacro:property name="front_wheel_hold_height" value="0.15" />

	<xacro:property name="backrest_height" value="0.55" />
    <xacro:property name="backrest_thickness" value="0.13" />
    <xacro:property name="backrest_width" value="0.40" />
	<xacro:property name="backrest_x_offset" value="${-backrest_thickness}" />

    <!-- arms -->
    <xacro:property name="arm_height" value="0.06" />
    <xacro:property name="arm_width" value="0.075" />
    <xacro:property name="left_arm_length" value="0.25" />
    <xacro:property name="right_arm_length" value="0.45" />
    <xacro:property name="arm_offset_vertical" value="0.18" />
    <xacro:property name="arm_z_offset" value="0.096" />


    <!-- Main base prism -->
    <xacro:property name="robot_base_length" value="0.838" />
    <xacro:property name="robot_base_width" value="0.49" />
    <xacro:property name="robot_base_height" value="0.404" />
    <xacro:property name="robot_base_z_offset"
		    value="${front_wheel_diameter / 2.0}" />

	<!-- footrest -->
    <xacro:property name="footrest_length" value="0.2" />
    <xacro:property name="footrest_width" value="0.31" />
    <xacro:property name="footrest_height" value="0.01" />
    <xacro:property name="footrest_offset" value="0.02" />

	<!-- camera_pole -->
    <xacro:property name="camera_pole_height" value="${1.12 + 0.06}" />
    <xacro:property name="camera_pole_diameter" value="0.039" />
    <xacro:property name="camera_mount_length" value="0.28" />
    <xacro:property name="camera_pole_x_offset" value="0.0" />
    <xacro:property name="camera_pole_y_offset" value="0.019" />
    
    <!-- Seat cusion -->
    <xacro:property name="seat_cusion_height" value="0.05" />
    <xacro:property name="seat_cusion_width" value="0.44" />
    <xacro:property name="seat_cusion_length" value="0.44" />
    <xacro:property name="seat_x_offset" value="0.05" />


		
    <xacro:macro name="color_black">
      <material name="black">
        <color rgba="0.3 0.3 0.4 1.0" />
      </material>
    </xacro:macro>
    
    <xacro:macro name="color_orange">
      <material name="orange">
        <color rgba="1.0 0.5 0 1.0" />
      </material>
    </xacro:macro>
    
    <xacro:macro name="color_gray">
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </xacro:macro>
    
    <xacro:macro name="color_darkgray1">
      <material name="dark_gray">
        <color rgba="0.4 0.4 0.5 1.0" />
      </material>
    </xacro:macro>
    
	<!-- useful macros -->
	<xacro:macro name="prism" params="name x y z *color">
	  <link name="${name}">
            <visual>
              <geometry>
		<box size="${x} ${y} ${z}" />
              </geometry>
              <xacro:insert_block name="color" />
        </visual>
        <collision>
          <geometry>
            <box size="${x} ${y} ${z}" />
          </geometry>
        </collision>
	  </link>
	</xacro:macro>
	
	<xacro:macro name="cyl" params="name radius length *color">
          <link name="${name}">
            <visual>
              <geometry>
                <cylinder radius="${radius}" length="${length}" />
              </geometry>
              <xacro:insert_block name="color" />
            </visual>
            <collision>
              <geometry>
                <cylinder radius="${radius}" length="${length}" />
              </geometry>
            </collision>
          </link>
	</xacro:macro>
	<!-- end useful macros -->
	
	<!-- Building up the robot -->
	<link name="base_footprint" />
	<joint name="base_footprint_to_base_link" type="fixed">
	  <parent link="base_footprint" />
	  <child link="base_link" />
      <origin
          xyz="0 0 ${rear_wheel_diameter / 2.0}"
          rpy="0 0 0" />
    </joint>
	
    <link name="base_link" />
